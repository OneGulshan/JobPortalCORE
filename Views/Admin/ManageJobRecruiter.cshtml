@model IEnumerable<JobPortalCORE.Models.Company>

@{
    ViewData["Title"] = "Manage Job Recruiter";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🏢 Manage Recruiters (Companies)</h2>
        <a asp-action="Create" class="btn btn-primary shadow-sm">➕ Create New</a>
    </div>

    <div class="table-responsive shadow-sm bg-white rounded p-3">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.Email)</th>
                    <th>@Html.DisplayNameFor(model => model.Password)</th>
                    <th>@Html.DisplayNameFor(model => model.Comment)</th>
                    <th>Profile ID</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-primary">
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>
                        
                        <td style="word-break: break-all; min-width: 150px;">
                            @Html.DisplayFor(modelItem => item.Email)
                        </td>
                        
                        <td>
                            @Html.DisplayFor(modelItem => item.Password)
                        </td>
                        
                        <td style="min-width: 200px;">
                            @Html.DisplayFor(modelItem => item.Comment)
                        </td>
                        
                        <td>
                            <span class="badge bg-secondary">Profile: @Html.DisplayFor(modelItem => item.JobProfileId)</span>
                        </td>
                        
                        <td>
                            <a asp-action="ApproveJobRecruiter" asp-route-id="@item.Id" class="btn btn-sm @(item.Status == true ? "btn-success" : "btn-warning text-dark")">
                                @(item.Status == true ? "Approved" : "Not Approved")
                            </a>
                        </td>
                        
                        <td>
                            <a asp-action="DeleteJobRecruiter" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Bhai, is recruiter/company ko sach mein delete karna hai?');">
                                🗑️ Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>