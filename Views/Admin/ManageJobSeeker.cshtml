@model IEnumerable<JobPortalCORE.ViewModels.ManageJobSeekerViewModel>

@{
    ViewData["Title"] = "ManageJobSeeker";
}

<div class="container-fluid mt-4">
    <h2 class="mb-4">🧑‍🎓 Manage Job Seekers</h2>

    <div class="table-responsive shadow-sm bg-white rounded p-3">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.EName)</th>
                    <th>@Html.DisplayNameFor(model => model.Gender)</th>
                    <th>@Html.DisplayNameFor(model => model.JPName)</th>
                    <th>@Html.DisplayNameFor(model => model.SName)</th>
                    <th>@Html.DisplayNameFor(model => model.Email)</th>
                    <th>@Html.DisplayNameFor(model => model.Password)</th>
                    <th>@Html.DisplayNameFor(model => model.Mobno)</th>
                    <th>@Html.DisplayNameFor(model => model.Age)</th>
                    <th>@Html.DisplayNameFor(model => model.CountryName)</th>
                    <th>@Html.DisplayNameFor(model => model.StateName)</th>
                    <th>@Html.DisplayNameFor(model => model.CityName)</th>
                    <th>@Html.DisplayNameFor(model => model.ImagePath)</th>
                    <th>@Html.DisplayNameFor(model => model.Comment)</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        @Html.HiddenFor(modelItem => item.Id)
                        <td class="fw-bold">@Html.DisplayFor(modelItem => item.EName)</td>
                        <td>@Html.DisplayFor(modelItem => item.Gender)</td>
                        <td><span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.JPName)</span></td>
                        <td>@Html.DisplayFor(modelItem => item.SName)</td>
                        
                        <td style="word-break: break-all; min-width: 150px;">
                            @Html.DisplayFor(modelItem => item.Email)
                        </td>
                        
                        <td>@Html.DisplayFor(modelItem => item.Password)</td>
                        <td>@Html.DisplayFor(modelItem => item.Mobno)</td>
                        <td>@Html.DisplayFor(modelItem => item.Age)</td>
                        <td>@Html.DisplayFor(modelItem => item.CountryName)</td>
                        <td>@Html.DisplayFor(modelItem => item.StateName)</td>
                        <td>@Html.DisplayFor(modelItem => item.CityName)</td>
                        
                        <td style="word-break: break-all; min-width: 200px; font-size: 0.85em;">
                            @Html.DisplayFor(modelItem => item.ImagePath)
                        </td>
                        
                        <td style="min-width: 150px;">@Html.DisplayFor(modelItem => item.Comment)</td>
                        
                        <td>
                            <a asp-action="ApproveJobSeeker" asp-route-id="@item.Id" class="btn btn-sm @(item.Status == true ? "btn-success" : "btn-warning")">
                                @(item.Status == true ? "Approved" : "Not Approved")
                            </a>
                        </td>
                        <td>
                            <a asp-action="DeleteJobSeeker" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Bhai, sach mein delete karna hai?');">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>