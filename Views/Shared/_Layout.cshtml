<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JobPortal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
            :root {
                --sidebar-width: 250px;
                --top-nav-height: 60px;
                --primary-gradient: linear-gradient(135deg, #6366f1 0%, #4338ca 100%);
            }

            body {
                background-color: #f8fafc;
                overflow-x: hidden;
            }

            /* Modern Navbar */
            .navbar-custom {
                height: var(--top-nav-height);
                background: rgba(255, 255, 255, 0.9);
                backdrop-filter: blur(10px);
                border-bottom: 1px solid #e2e8f0;
                position: sticky;
                top: 0;
                z-index: 1020;
            }

            /* Dashboard Logo */
            .navbar-brand {
                font-weight: 800;
                color: #4338ca !important;
                letter-spacing: -0.5px;
            }

            /* Admin Dropdown Hover  */
            .nav-item.dropdown:hover .dropdown-menu {
                display: block;
                margin-top: 0 !important;
                border: 0;
                box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            }

            /* Hover gap bridge  */
            .nav-item.dropdown {
                padding-bottom: 5px;
            }

            /* Content Area */
            .main-wrapper {
                padding: 2rem;
                min-height: calc(100vh - var(--top-nav-height) - 60px);
            }

            /* Action Buttons & Links */
            .nav-link {
                font-weight: 500;
                transition: all 0.2s ease;
                color: #64748b !important;
            }

                .nav-link:hover {
                    color: #4338ca !important;
                    transform: translateY(-1px);
                }

            .active-link {
                color: #4338ca !important;
                font-weight: 700;
            }

            /* Footer  */
            footer {
                background: white;
                padding: 1.5rem 0;
                border-top: 1px solid #e2e8f0;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom shadow-sm">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-briefcase-fill me-2"></i> JobPortal
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="JobSeeker" asp-action="Index">
                                <i class="bi bi-people me-1"></i> Seekers
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="JobRecruiter" asp-action="Index">
                                <i class="bi bi-building me-1"></i> Recruiters
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="jobDropdown" role="button">
                                <i class="bi bi-journal-plus me-1"></i> Jobs
                            </a>
                            <ul class="dropdown-menu border-0 shadow-sm rounded-3">
                                <li><a class="dropdown-item" asp-controller="JobPost" asp-action="Create"><i class="bi bi-plus-circle me-2"></i>Post New Job</a></li>
                                <li><a class="dropdown-item" asp-controller="JobPost" asp-action="Index"><i class="bi bi-gear me-2"></i>Manage Jobs</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="JobSeeker" asp-action="ViewJobs"><i class="bi bi-eye me-2"></i>Browse as Seeker</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle fw-bold text-indigo" href="#" id="adminDropdown">
                                <i class="bi bi-shield-lock-fill me-1"></i> Admin Panel
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-3 mt-2">
                                <li class="dropdown-header text-uppercase small fw-bold">Management</li>
                                <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="ManageJobPost">💼 Manage Job Posts</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="ManageJobSeeker">🧑‍🎓 Manage Job Seekers</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="ManageJobRecruiter">🏢 Manage Recruiters</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2 text-danger fw-bold" asp-controller="Admin" asp-action="AuditHistory"><i class="bi bi-activity me-2"></i>Audit History (Logs)</a></li>
                            </ul>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="main-wrapper container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="text-muted">
        <div class="container text-center">
            <p class="mb-0">&copy; 2026 - <strong>JobPortal Dashboard</strong>. Crafted with ❤️ by Gulshan</p>
            <div class="mt-2 small">
                <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none mx-2">Privacy</a>
                <span class="text-secondary">•</span>
                <a href="#" class="text-decoration-none mx-2">Terms</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jQuery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @*<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>*@

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        $(document).ready(function () {
        // const connection = new signalR.HubConnectionBuilder()
        // .withUrl("/notificationHub")
        // .withAutomaticReconnect() // 👈 Ye line jadoo karegi, isko add kar de
        // .build();

        connection.on("ReceiveNotification", function (message) {
        // Jaise hi cloud se message aayega, Toaster chalega
        toastr.success(message, "Cloud Background Task ☁️", {
        timeOut: 8000,
        positionClass: "toast-bottom-right"
        });
        });

        connection.start().then(function () {
        console.log("Azure SignalR: Live Pipe Connect ho gaya hai!");
        }).catch(function (err) {
        console.error("SignalR Connection Error: ", err.toString());
        });
        });
    </script>
</body>
</html>