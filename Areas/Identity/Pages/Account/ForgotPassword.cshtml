@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            <div class="card shadow-lg border-0 rounded-4 text-center overflow-hidden">
                
                <div class="card-header bg-white border-0 pt-5 pb-0">
                    <div class="display-1 text-primary mb-3">
                        <i class="bi bi-key-fill"></i>
                    </div>
                    <h2 class="fw-bold">Password Bhool Gaye?</h2>
                    <p class="text-muted px-3 small">
                        Fikar mat karein! Apna registered email address yahan daalein aur hum aapko naya password banane ka link bhejenge.
                    </p>
                </div>

                <div class="card-body p-4 p-md-5 pt-3">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                        <div class="form-floating mb-4 text-start">
                            <input asp-for="Input.Email" class="form-control rounded-3 bg-light border-0" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email" class="form-label text-muted">
                                <i class="bi bi-envelope me-1"></i> Email Address
                            </label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="w-100 btn btn-lg btn-primary fw-bold rounded-pill shadow-sm">
                            📩 Send Reset Link
                        </button>
                    </form>

                    <div class="mt-4 pt-3 border-top">
                        <a asp-page="./Login" class="text-decoration-none text-muted small fw-bold">
                            <i class="bi bi-arrow-left me-1"></i> Back to Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}